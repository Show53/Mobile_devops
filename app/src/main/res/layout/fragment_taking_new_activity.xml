<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <LinearLayout
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:id="@+id/menu"
        android:background="@drawable/custom_shape_new_activity_menu"
        android:paddingVertical="32dp"
        android:paddingHorizontal="16dp"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/activity_title"
            android:textAllCaps="false"
            android:textColor="@color/black"
            android:gravity="center"
            android:textFontWeight="700"
            android:textSize="24sp"
            android:letterSpacing="0"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/new_activity_menu_title">
        </TextView>

        <androidx.core.widget.NestedScrollView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <HorizontalScrollView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:scrollbars="none">


                <LinearLayout
                    android:id="@+id/holder_activities_types"
                    android:layout_marginTop="24dp"
                    android:paddingHorizontal="8dp"
                    android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:id="@+id/bicycle_activity"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:background="@drawable/new_activity_item"
                        android:gravity="center">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:text="@string/new_item_bicycle"
                            android:textSize="16sp"
                            android:textColor="@color/black"/>

                        <ImageView
                            android:layout_marginStart="10dp"
                            android:layout_width="102dp"
                            android:layout_height="84dp"
                            android:background="@drawable/ic_new_activity"/>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/running_activity"
                        android:layout_marginStart="8dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:background="@drawable/new_activity_item"
                        android:gravity="center">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:text="@string/new_item_running"
                            android:textSize="16sp"
                            android:textColor="@color/black"/>

                        <ImageView
                            android:layout_marginStart="10dp"
                            android:layout_width="102dp"
                            android:layout_height="84dp"
                            android:background="@drawable/ic_new_activity"/>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/swimming_activity"
                        android:layout_marginStart="8dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:background="@drawable/new_activity_item"
                        android:gravity="center">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:text="@string/new_item_swimming"
                            android:textSize="16sp"
                            android:textColor="@color/black"/>

                        <ImageView
                            android:layout_marginStart="10dp"
                            android:layout_width="102dp"
                            android:layout_height="84dp"
                            android:background="@drawable/ic_new_activity"/>
                    </LinearLayout>
                </LinearLayout>
            </HorizontalScrollView>
        </androidx.core.widget.NestedScrollView>

        <Button
            android:id="@+id/start_activity"
            android:layout_width="match_parent"
            android:backgroundTint="@color/violet"
            android:layout_height="48dp"
            android:text="@string/new_activitie_button_text"
            android:textSize="16sp"
            android:letterSpacing="0"
            android:textFontWeight="700"
            app:layout_constraintTop_toBottomOf="@+id/holder_activities_types"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="32dp"
            android:textColor="@color/white"
            android:textAllCaps="false">
        </Button>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>